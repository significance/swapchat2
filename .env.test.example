# Test environment — requires a running Bee node with CORS enabled
# and a valid postage stamp with client-side signing capability

VITE_BEE_API=http://localhost:1633
VITE_BEE_GATEWAY_MODE=false
VITE_BEE_STAMP=your_batch_id_here
VITE_BEE_SIGNER_KEY=your_signer_private_key_here
VITE_BEE_STAMP_DEPTH=20
VITE_REQUIRE_TERMS=true
